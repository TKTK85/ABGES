# Generated analysis data and runtime state
workspace/
*.log

# Archived legacy implementation includes source data and duplicate engines.
# It is intentionally outside the active Harness baseline.
impl/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Computation engines (HIBLUP, PLINK) are bundled and distributed with the
# repository. The Harness verifies their SHA-256 checksums at runtime against
# tools/ENGINE_MANIFEST.json. Only runtime logs and bytecode caches stay local
# (covered by *.log and __pycache__/ rules above).

.venv/
configs/mcp-access.json
configs/mcp-access*.json
workspace/control_plane/
workspace/mcp_tasks/

# Breeding datasets, engine results, and private release artifacts
data/
**/input/raw/
*.xlsx
*.xls
*.xlsm
*.csv
*.tsv
*.bed
*.bim
*.fam
*.ped
*.map
*.vcf
*.vcf.gz
*.vars
*.rand
.coverage
.coverage.*
releases/
